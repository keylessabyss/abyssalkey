{
  "format": "AbyssalWingsUI",
  "formatVersion": 21,
  "assetId": "UI.UI1789123456789",
  "displayName": "Graphics Settings",
  "description": "Player renderer preference shown from the Start HUD.",
  "tags": ["UI", "Project", "Settings"],
  "canvas": { "nodeId": "Canvas", "displayName": "Canvas", "width": 1920, "height": 1080 },
  "nodes": [
    {
      "nodeId": "Overlay_GraphicsSettings",
      "type": "Overlay",
      "parentNodeId": "Canvas",
      "displayName": "Graphics Settings",
      "localX": 0,
      "localY": 0,
      "width": 820,
      "height": 640,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "outlineEnabled": true,
      "outlineColor": [0.25, 0.72, 0.88, 1],
      "outlineThickness": 2,
      "selectorEnabled": true,
      "selectorDefaultOverlayNodeId": "Overlay_SettingsActions",
      "selectorBackDismissesUI": true,
      "selectorInputBindings": [
        { "action": "UI.Up", "controls": ["ArrowUp", "Gamepad0.Button12"] },
        { "action": "UI.Down", "controls": ["ArrowDown", "Gamepad0.Button13"] },
        { "action": "UI.Left", "controls": ["ArrowLeft", "Gamepad0.Button14"] },
        { "action": "UI.Right", "controls": ["ArrowRight", "Gamepad0.Button15"] },
        { "action": "UI.Accept", "controls": ["Enter", "Gamepad0.Button0"] },
        { "action": "UI.Back", "controls": ["Backspace", "Escape", "Gamepad0.Button1"] }
      ]
    },
    {
      "nodeId": "Background_GraphicsSettings",
      "type": "Background",
      "parentNodeId": "Overlay_GraphicsSettings",
      "displayName": "Settings Panel",
      "width": 820,
      "height": 640,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "color": [0.035, 0.065, 0.08, 0.96]
    },
    {
      "nodeId": "Text_GraphicsSettingsTitle",
      "type": "Text",
      "parentNodeId": "Overlay_GraphicsSettings",
      "displayName": "Settings Title",
      "localY": -238,
      "width": 700,
      "height": 70,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "Graphics Settings",
      "color": [0.92, 0.98, 1, 1],
      "fontSize": 42,
      "textHorizontalAlignment": "Center",
      "textVerticalAlignment": "Center"
    },
    {
      "nodeId": "Text_GraphicsSettingsHelp",
      "type": "Text",
      "parentNodeId": "Overlay_GraphicsSettings",
      "displayName": "Settings Help",
      "localY": -174,
      "width": 690,
      "height": 54,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "Choose WebGPU or WebGL2. Your choice is saved in this browser; Play restarts to apply it.",
      "color": [0.72, 0.82, 0.87, 1],
      "fontSize": 20,
      "textHorizontalAlignment": "Center",
      "textVerticalAlignment": "Center"
    },
    {
      "nodeId": "Text_GraphicsSettingsStatus",
      "type": "Text",
      "parentNodeId": "Overlay_GraphicsSettings",
      "displayName": "Renderer Status",
      "localY": -102,
      "width": 700,
      "height": 62,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "Renderer preference",
      "color": [0.45, 0.92, 0.69, 1],
      "fontSize": 20,
      "textHorizontalAlignment": "Center",
      "textVerticalAlignment": "Center",
      "driver": {
        "source": "Game.Graphics.BackendPreference",
        "target": "TextValue",
        "format": "{value}"
      }
    },
    {
      "nodeId": "Overlay_SettingsActions",
      "type": "Overlay",
      "parentNodeId": "Overlay_GraphicsSettings",
      "displayName": "Renderer Choices",
      "localY": 65,
      "width": 520,
      "height": 250,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center"
    },
    {
      "nodeId": "Button_UseWebGL2",
      "type": "Button",
      "parentNodeId": "Overlay_SettingsActions",
      "displayName": "Use WebGL2 Toggle",
      "localY": -35,
      "width": 420,
      "height": 68,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "Use WebGL2",
      "backgroundColor": [0.1, 0.29, 0.4, 1],
      "textColor": [0.95, 0.98, 1, 1],
      "enabled": true,
      "inputChannel": "None",
      "selectorCommand": "ToggleGraphicsBackend"
    },
    {
      "nodeId": "Button_BackToStart",
      "type": "Button",
      "parentNodeId": "Overlay_SettingsActions",
      "localY": 38,
      "width": 340,
      "height": 68,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "Back",
      "backgroundColor": [0.1, 0.22, 0.29, 1],
      "textColor": [0.95, 0.98, 1, 1],
      "enabled": true,
      "inputChannel": "None",
      "onClickSource": "OnClick()\n{\n    Destroy(Self.UI);\n}"
    }
  ]
}
