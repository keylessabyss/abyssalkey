{
  "format": "AbyssalWingsUI",
  "formatVersion": 21,
  "assetId": "UI.UI1790000000001",
  "displayName": "Choose Your Side",
  "description": "Choose the faction for this local match.",
  "tags": ["UI", "Project", "Match Setup"],
  "canvas": { "nodeId": "Canvas", "displayName": "Canvas", "width": 1920, "height": 1080 },
  "nodes": [
    {
      "nodeId": "Overlay_SideSelection",
      "type": "Overlay",
      "parentNodeId": "Canvas",
      "displayName": "Choose Your Side",
      "width": 820,
      "height": 650,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "outlineEnabled": true,
      "outlineColor": [0.25, 0.72, 0.88, 1],
      "outlineThickness": 2,
      "selectorEnabled": true,
      "selectorDefaultOverlayNodeId": "Overlay_SideActions",
      "selectorInputBindings": [
        { "action": "UI.Up", "controls": ["ArrowUp", "Gamepad0.Button12"] },
        { "action": "UI.Down", "controls": ["ArrowDown", "Gamepad0.Button13"] },
        { "action": "UI.Left", "controls": ["ArrowLeft", "Gamepad0.Button14"] },
        { "action": "UI.Right", "controls": ["ArrowRight", "Gamepad0.Button15"] },
        { "action": "UI.Accept", "controls": ["Enter", "Gamepad0.Button0"] },
        { "action": "UI.Back", "controls": ["Backspace", "Escape", "Gamepad0.Button1"] }
      ]
    },
    {
      "nodeId": "Background_SideSelection",
      "type": "Background",
      "parentNodeId": "Overlay_SideSelection",
      "displayName": "Side Selection Panel",
      "width": 820,
      "height": 650,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "color": [0.035, 0.065, 0.08, 0.96]
    },
    {
      "nodeId": "Text_SideSelectionTitle",
      "type": "Text",
      "parentNodeId": "Overlay_SideSelection",
      "displayName": "Side Selection Title",
      "localY": -238,
      "width": 700,
      "height": 70,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "Choose Your Side",
      "color": [0.92, 0.98, 1, 1],
      "fontSize": 42,
      "textHorizontalAlignment": "Center",
      "textVerticalAlignment": "Center"
    },
    {
      "nodeId": "Text_SideSelectionHelp",
      "type": "Text",
      "parentNodeId": "Overlay_SideSelection",
      "displayName": "Side Selection Help",
      "localY": -172,
      "width": 690,
      "height": 54,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "Choose a faction. Rookie will join the opposing side.",
      "color": [0.72, 0.82, 0.87, 1],
      "fontSize": 20,
      "textHorizontalAlignment": "Center",
      "textVerticalAlignment": "Center"
    },
    {
      "nodeId": "Overlay_SideActions",
      "type": "Overlay",
      "parentNodeId": "Overlay_SideSelection",
      "displayName": "Faction Choices",
      "localY": 38,
      "width": 520,
      "height": 390,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center"
    },
    {
      "nodeId": "Button_JoinDay",
      "type": "Button",
      "parentNodeId": "Overlay_SideActions",
      "displayName": "Join Day",
      "localY": -65,
      "width": 440,
      "height": 72,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "DAY",
      "description": "Defend Morninghollow as part of the Day side.",
      "backgroundColor": [0.08, 0.34, 0.48, 1],
      "textColor": [0.75, 0.94, 1, 1],
      "enabled": true,
      "inputChannel": "None",
      "onClickSource": "OnClick()\n{\n    ForceLandscape();\n    Spawn(StandardApex)\n        .PlayerStart()\n        .Team(Morninghollow.Day)\n        .Controller(Player1);\n    ShowUI(\"Player HUD\");\n    Destroy(Self.UI);\n}"
    },
    {
      "nodeId": "Button_JoinNight",
      "type": "Button",
      "parentNodeId": "Overlay_SideActions",
      "displayName": "Join Night",
      "localY": 15,
      "width": 440,
      "height": 72,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "NIGHT",
      "description": "Fight from Morninghollow's Night side.",
      "backgroundColor": [0.38, 0.12, 0.19, 1],
      "textColor": [1, 0.76, 0.8, 1],
      "enabled": true,
      "inputChannel": "None",
      "onClickSource": "OnClick()\n{\n    ForceLandscape();\n    Spawn(StandardApex)\n        .PlayerStart()\n        .Team(Morninghollow.Night)\n        .Controller(Player1);\n    ShowUI(\"Player HUD\");\n    Destroy(Self.UI);\n}"
    },
    {
      "nodeId": "Button_BackToStart",
      "type": "Button",
      "parentNodeId": "Overlay_SideActions",
      "displayName": "Back to Start",
      "localY": 95,
      "width": 340,
      "height": 64,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "Back",
      "description": "Return to the Start screen.",
      "backgroundColor": [0.1, 0.22, 0.29, 1],
      "textColor": [0.95, 0.98, 1, 1],
      "enabled": true,
      "inputChannel": "None",
      "onClickSource": "OnClick()\n{\n    ShowUI(\"Start HUD\");\n    Destroy(Self.UI);\n}"
    },
    {
      "nodeId": "Button_ResetMatchCurrency",
      "type": "Button",
      "parentNodeId": "Overlay_SideActions",
      "displayName": "Reset Match Currency",
      "localY": -145,
      "width": 440,
      "height": 56,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "Reset Currency",
      "description": "Off keeps your current currency. Turn on to reset match currency when you choose a side.",
      "backgroundColor": [0.1, 0.22, 0.29, 1],
      "textColor": [0.95, 0.98, 1, 1],
      "enabled": true,
      "inputChannel": "None",
      "selectorCommand": "ToggleMatchCurrencyReset"
    },
    {
      "nodeId": "Text_SideSelectionDescription",
      "type": "Text",
      "parentNodeId": "Overlay_SideSelection",
      "displayName": "Focused Choice Description",
      "localY": 238,
      "width": 700,
      "height": 56,
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "text": "",
      "driver": {
        "source": "Selector.FocusedButton.Description",
        "target": "TextValue",
        "format": "{value}"
      },
      "color": [0.82, 0.9, 0.94, 1],
      "fontSize": 20,
      "textHorizontalAlignment": "Center",
      "textVerticalAlignment": "Center"
    }
  ]
}
